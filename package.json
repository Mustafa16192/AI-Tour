{
  "name": "ai-integration-tour",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.82",
    "ai": "^7.0.159",
    "expo": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:infrastructure": "jest --runInBand --runTestsByPath __tests__/infrastructure/projectInfrastructure.test.js",
    "check-progress": "node scripts/check-progress.js",
    "check-progress:report": "node scripts/check-progress.js --report-only",
    "lint": "expo lint",
    "verify": "npm run check-progress && npm run lint && npm test"
  },
  "private": true,
  "devDependencies": {
    "@babel/parser": "7.26.10",
    "@babel/traverse": "7.26.10",
    "@testing-library/react-native": "13.3.3",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3"
  }
}
